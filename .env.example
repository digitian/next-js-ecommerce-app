# Cloudflare Turnstile (contact form CAPTCHA)
# Get test/production keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

NEXT_PUBLIC_APP_NAME="Marlow Home"

# Public site URL, used for canonical links, Open Graph tags, robots.txt and sitemap.xml.
# Set this to your production domain when deploying (e.g. https://marlow-home.vercel.app).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
